# =========================================================
# CONFIGURAÇÕES DE PRODUÇÃO - CONTROLE FINANCEIRO
# =========================================================

# Chave secreta da aplicação (gere uma chave aleatória com: python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=cole_aqui_uma_chave_aleatoria_longa_e_segura

# Mercado Pago Access Token oficial para receber webhooks em produção
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-token-aqui

# Ativar cookies seguros apenas via HTTPS (defina como true após ativar o SSL no Nginx)
SESSION_COOKIE_SECURE=true

# Ambiente Flask (production)
FLASK_ENV=production
